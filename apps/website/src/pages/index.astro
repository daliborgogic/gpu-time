---
import '../styles/global.css';
import { parse } from 'gpu-time';
import { demoDefault, format } from '../lib/demo';
import Logo from '../components/Logo.astro';
import Code from '../components/Code.astro';
import { Demo } from '../components/Demo';
import { Examples } from '../components/Examples';
import { Video } from '../components/Video';

const reference = new Date();
const timeZone = 'UTC';
const initial = format(await parse(demoDefault, {
  reference: reference.toISOString(), timeZone, limit: 3,
}), reference, timeZone);

const title = '@dlbr/gpu-time — Od teksta do ISO datuma';
const description =
  '@dlbr/gpu-time je mali neuronski parser koji pretvara svakodnevni srpski (latinica) u datume, vremenske periode i RFC 5545 pravila ponavljanja. Model radi lokalno u vašem pregledaču, na CPU ili WebGPU-u.';
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og.png?v=sr-1', Astro.site);
---
<!doctype html>
<html lang="sr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Arik Chakma" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="dalibor_gogic" />
    <meta property="og:locale" content="sr_RS" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="@dlbr/gpu-time pretvara „svaki ponedeljak od 8 uveče do 10 uveče“ u pravi datum i vremenski period" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="@dlbr/gpu-time pretvara „svaki ponedeljak od 8 uveče do 10 uveče“ u pravi datum i vremenski period" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: '@dlbr/gpu-time',
      description,
      url: canonical.href,
      image: image.href,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      license: 'https://opensource.org/licenses/MIT',
      author: { '@type': 'Person', name: 'Dalibor Gogic' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    })} />
  </head>
  <body class="m-0 bg-white font-sans text-black antialiased [&_a]:[text-underline-offset:4px]">
    <main class="mx-auto max-w-[600px] px-6 py-12 [&_h1]:text-balance [&_h2]:text-balance [&_h2]:text-center">
      <header class="text-center">
        <a href="/" aria-label="gpu-time home" class="inline-flex h-12 items-center gap-2.5 text-2xl font-medium tracking-[-0.5px] no-underline [&_svg]:size-9">
          <Logo />@dlbr/gpu-time
        </a>
        <h1 class="mt-8 text-3xl font-medium leading-[1.15] tracking-[-0.6px]">Plain Serbian to Real Dates</h1>
        <p class="mx-auto mt-3 max-w-[420px] text-body text-neutral-600">A small neural model, running locally in your browser</p>
      </header>

      <Demo client:load initial={initial} />
      <noscript><p class="mt-3 text-center text-sm">Enable JavaScript to try your own phrase.</p></noscript>

      <section class="mt-14" aria-labelledby="examples-title">
        <h2 id="examples-title" class="text-heading font-medium">Tap One, See the Dates</h2>
        <p class="mx-auto mb-5 mt-1.5 max-w-note text-center text-note leading-normal text-neutral-500">Each of these runs in the box above</p>
        <Examples client:load />
      </section>

      <section class="mt-14" aria-labelledby="use-title">
        <h2 id="use-title" class="text-heading font-medium">Use It in Your Code</h2>
        <p class="mx-auto mb-5 mt-1.5 max-w-note text-center text-note leading-normal text-neutral-500">You pass the phrase, your reference instant, and your timezone. You get back dates and RFC 5545 rules</p>
        <Code />
      </section>

      <section class="mt-14" aria-labelledby="film-title">
        <h2 id="film-title" class="text-heading font-medium">Inside the Model</h2>
        <p class="mx-auto mb-5 mt-1.5 max-w-note text-center text-note leading-normal text-neutral-500">Words to scores to dates, in 32,953 parameters</p>
        <Video client:load />
        <noscript><p class="mt-3 text-sm"><a href="/media/gpu-time-neural.mp4?v=chicago-4">Watch the walkthrough</a></p></noscript>
        <p class="mx-auto mt-3 max-w-note text-center text-note leading-normal text-neutral-500">Actual model activations and scores. Connections simplified for clarity</p>
      </section>

      <footer class="mt-14 text-center">
        <h2 class="text-heading font-medium">A Small Experiment. Still Growing</h2>
        <div class="mx-auto mt-3 max-w-note space-y-3 text-body text-neutral-600">
          <p>Time comes in all kinds of words. Try a one-off plan, a weekly routine, or an overnight shift in the demo above.</p>
          <p>@dlbr/gpu-time is still learning the edges of everyday language. Unfamiliar wording can trip it up, so check the results and see how it handles the way you write.</p>
        </div>
        <a href="#demo-input" class="mt-4 inline-flex items-center justify-center rounded-full bg-black px-3.5 py-2.5 text-sm font-medium leading-none tracking-[-0.14px] text-white no-underline transition-colors hover:bg-neutral-700">Try your own phrase <span class="ml-2" aria-hidden="true">↗</span></a>
        <p class="mt-4 text-body text-black/40">@dlbr/gpu-time<br />A small experiment in understanding time</p>
      </footer>
    </main>
  </body>
</html>
